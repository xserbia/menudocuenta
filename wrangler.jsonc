{
  "name": "emc-chatbot-public",
  "main": "emc-chatbot-worker.js",
  "compatibility_date": "2026-11-21",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "chat.elmenudocuenta.com", "custom_domain": true }
  ],
  "vars": {
    "PUBLIC_CHAT": "true"
  },
  "ratelimits": [
    {
      "name": "CHAT_RATE_LIMITER",
      "namespace_id": "20261121",
      "simple": { "limit": 8, "period": 60 }
    }
  ]
}
